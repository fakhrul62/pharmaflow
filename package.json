{
  "name": "pharmaflow-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @pharmaflow/api\" \"npm run dev -w @pharmaflow/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @pharmaflow/api",
    "db:migrate": "npm run db:migrate -w @pharmaflow/api",
    "db:seed": "npm run db:seed -w @pharmaflow/api",
    "setup": "node scripts/setup.mjs",
    "test:e2e": "playwright test",
    "lint": "prettier --check apps/web/src apps/api/src apps/api/scripts packages/shared scripts tests playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.44.0": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
